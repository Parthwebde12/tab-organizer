{
  "manifest_version": 3,
  "name": "Tab Organizer Pro",
  "description": "Advanced tab grouping and management for Chrome.",
  "version": "2.0",
  "permissions": [
    "tabs",
    "storage",
    "sessions",
    "tabGroups"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon128.png"
  }
}